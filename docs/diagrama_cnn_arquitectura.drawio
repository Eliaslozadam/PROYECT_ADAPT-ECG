    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECCIÓN C: MÓDULO DE REENTRENAMIENTO CONTINUO -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Fondo sección C -->
    <mxCell id="200" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;opacity=40;" vertex="1" parent="1">
      <mxGeometry x="150" y="960" width="3100" height="650" as="geometry"/>
    </mxCell>

    <!-- Título sección C -->
    <mxCell id="201" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;C. Módulo de Reentrenamiento Continuo — Diferencia entre Modelo Base y Modelo Adaptativo&lt;/font&gt;&lt;/b&gt;"
          style="text;html=1;align=left;strokeColor=none;fillColor=none;fontColor=#1b5e20;fontSize=13;"
          vertex="1" parent="1">
      <mxGeometry x="170" y="972" width="2000" height="30" as="geometry"/>
    </mxCell>

    <!-- Modelo Base -->
    <mxCell id="202" value="&lt;b&gt;ecg_cnn_base.pth&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modelo Base (Estático)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Entrenado con:&lt;br&gt;• 94,627 latidos totales&lt;br&gt;• 30 épocas completas&lt;br&gt;• lr = 1e-3 (Adam)&lt;br&gt;• Batch = 64&lt;br&gt;• Weighted NLLLoss&lt;br&gt;&lt;br&gt;Resultado:&lt;br&gt;&lt;b&gt;Accuracy: 93.54%&lt;/b&gt;&lt;br&gt;&lt;b&gt;F1 Macro: 0.7849&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;NO se modifica con nuevos datos&lt;br&gt;Sirve como punto de referencia&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#23445d;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="170" y="1020" width="210" height="270" as="geometry"/>
    </mxCell>

    <!-- Replay Buffer -->
    <mxCell id="210" value="&lt;b&gt;Replay Buffer&lt;/b&gt;&lt;br&gt;replay_buffer.npz&lt;br&gt;&lt;br&gt;• Capacidad: 2,000 latidos&lt;br&gt;• Almacena muestras pasadas&lt;br&gt;• Selección aleatoria (sample)&lt;br&gt;• Persistente entre sesiones&lt;br&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt;&lt;br&gt;Evitar Catastrophic Forgetting.&lt;br&gt;Al entrenar con pacientes nuevos,&lt;br&gt;el modelo no olvida los anteriores&lt;br&gt;porque sigue viendo muestras&lt;br&gt;del buffer en cada sesión."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="530" y="1020" width="220" height="270" as="geometry"/>
    </mxCell>

    <!-- Nuevos datos -->
    <mxCell id="211" value="&lt;b&gt;Nuevos datos de paciente&lt;/b&gt;&lt;br&gt;(Registro MIT-BIH seleccionado)&lt;br&gt;&lt;br&gt;• Segmentación de latidos&lt;br&gt;• Etiquetas reales del archivo .atr&lt;br&gt;• Mapeo AAMI aplicado&lt;br&gt;&lt;br&gt;Ej: Registro 208&lt;br&gt;(N, V, S — &gt;2,000 latidos)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="530" y="1330" width="220" height="200" as="geometry"/>
    </mxCell>

    <!-- Mezcla 50/50 -->
    <mxCell id="212" value="&lt;b&gt;Mezcla de Datos&lt;/b&gt;&lt;br&gt;50% Buffer + 50% Nuevos&lt;br&gt;&lt;br&gt;np.random.permutation()&lt;br&gt;&lt;br&gt;Garantiza que el modelo vea&lt;br&gt;datos de TODOS los pacientes&lt;br&gt;en cada sesión de entrenamiento.&lt;br&gt;&lt;br&gt;Evita sesgo hacia los últimos datos."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="880" y="1150" width="215" height="210" as="geometry"/>
    </mxCell>

    <!-- Flechas hacia mezcla -->
    <mxCell id="213" value="Muestras del pasado" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#f9a825;strokeWidth=2;fontSize=9;" edge="1" source="210" target="212" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="214" value="Datos nuevos" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" source="211" target="212" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- incremental_train -->
    <mxCell id="215" value="&lt;b&gt;incremental_train()&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Optimizer: Adam&lt;br&gt;• lr = 1e-4 &lt;b&gt;(10x menor)&lt;/b&gt;&lt;br&gt;• Loss: CrossEntropyLoss&lt;br&gt;• Épocas por sesión: 5&lt;br&gt;• Batch: 64&lt;br&gt;&lt;br&gt;&lt;b&gt;Por qué lr más pequeño:&lt;/b&gt;&lt;br&gt;Cambios pequeños conservan&lt;br&gt;el conocimiento base.&lt;br&gt;Solo ajusta ligeramente los&lt;br&gt;pesos hacia los nuevos datos."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="1230" y="1100" width="225" height="270" as="geometry"/>
    </mxCell>

    <!-- Flecha mezcla → incremental_train -->
    <mxCell id="216" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="212" target="215" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flecha Modelo Base → incremental_train (carga pesos) -->
    <mxCell id="217" value="Carga pesos&lt;br&gt;iniciales" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=9;" edge="1" source="202" target="215" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Modelo Adaptativo -->
    <mxCell id="220" value="&lt;b&gt;ADAPT-ECG-RETRAINED.pth&lt;/b&gt;&lt;br&gt;&lt;i&gt;Modelo Adaptativo&lt;/i&gt;&lt;br&gt;&lt;br&gt;• Misma arquitectura CNN&lt;br&gt;• Pesos ACTUALIZADOS&lt;br&gt;• Se actualiza en cada sesión&lt;br&gt;&lt;br&gt;Resultado (Fase 3):&lt;br&gt;&lt;b&gt;Accuracy: 97.83%&lt;/b&gt;&lt;br&gt;&lt;b&gt;F1 Macro: 0.9071&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mejora vs Base:&lt;br&gt;&lt;b&gt;+4.29% accuracy&lt;/b&gt;&lt;br&gt;&lt;b&gt;+0.1222 F1 Macro&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;SÍ cambia con nuevos datos&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#1b5e20;fontSize=11;fontStyle=1;"
          vertex="1" parent="1">
      <mxGeometry x="1590" y="1020" width="220" height="320" as="geometry"/>
    </mxCell>

    <!-- Flecha incremental_train → Adaptativo -->
    <mxCell id="221" value="Guarda pesos&lt;br&gt;actualizados" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;" edge="1" source="215" target="220" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Actualiza Replay Buffer -->
    <mxCell id="222" value="&lt;b&gt;Actualiza Replay Buffer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Agrega nuevos latidos al buffer.&lt;br&gt;Si supera 2,000 → elimina los más antiguos.&lt;br&gt;(Cola FIFO — primero en entrar, primero en salir)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="1590" y="1420" width="320" height="90" as="geometry"/>
    </mxCell>

    <!-- Flecha Adaptativo → Actualiza Buffer -->
    <mxCell id="223" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#f9a825;strokeWidth=2;" edge="1" source="220" target="222" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flecha vuelta al Buffer (loop) -->
    <mxCell id="224" value="&lt;b&gt;Próxima sesión&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=10;" edge="1" source="222" target="210" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1750" y="1560"/>
          <mxPoint x="640" y="1560"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Historial -->
    <mxCell id="225" value="&lt;b&gt;retrain_history.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registra por sesión:&lt;br&gt;• Accuracy antes / después&lt;br&gt;• F1-Score antes / después&lt;br&gt;• Latidos procesados&lt;br&gt;• Loss por época&lt;br&gt;• Fecha y hora"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="1940" y="1100" width="215" height="200" as="geometry"/>
    </mxCell>

    <!-- Flecha Adaptativo → Historial -->
    <mxCell id="226" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3949ab;strokeWidth=2;" edge="1" source="220" target="225" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Caja diferencia Base vs Adaptativo -->
    <mxCell id="230" value="&lt;b&gt;¿Cuál es la diferencia entre Modelo Base y Modelo Adaptativo?&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Misma arquitectura:&lt;/b&gt; ECG_CNN exacta con 44,229 parámetros&lt;br&gt;• &lt;b&gt;La diferencia son los VALORES de los pesos:&lt;/b&gt; w[k] en Conv1d y matrices W en Linear&lt;br&gt;• El modelo base fue entrenado una sola vez con todos los datos (30 épocas, lr=1e-3)&lt;br&gt;• El modelo adaptativo refina sus pesos sesión a sesión (5 épocas c/u, lr=1e-4)&lt;br&gt;• El adaptativo reconoce mejor patrones de nuevos pacientes SIN olvidar los anteriores"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;align=left;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="2200" y="1020" width="1000" height="155" as="geometry"/>
    </mxCell>

    <!-- Comparativa Fase 4 -->
    <mxCell id="231" value="&lt;b&gt;Comparativa Final — Fase 4 (75,702 latidos, lotes 1-4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Modelo Estático:   Accuracy = 88.72%  |  F1 Macro = 0.7381&lt;br&gt;Modelo Adaptativo: Accuracy = 97.41%  |  F1 Macro = 0.8954&lt;br&gt;&lt;br&gt;&lt;b&gt;Mejora: +8.69% accuracy &amp;nbsp;|&amp;nbsp; +0.1573 F1 Macro&lt;/b&gt;&lt;br&gt;McNemar: &amp;chi;&amp;sup2; = 5342, p &amp;asymp; 0 → Diferencia estadísticamente significativa"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#1b5e20;align=left;fontSize=12;fontStyle=1;"
          vertex="1" parent="1">
      <mxGeometry x="2200" y="1215" width="1000" height="140" as="geometry"/>
    </mxCell>

    <!-- Notas técnicas importantes -->
    <mxCell id="232" value="&lt;b&gt;Notas técnicas importantes:&lt;/b&gt;&lt;br&gt;• BEAT_LEN = 71 (35 antes + pico R + 36 después)&lt;br&gt;• La capa clasificadora se llama self.classifier (no self.fc)&lt;br&gt;• Keys de los pesos: classifier.1 (Linear 128→64), classifier.4 (Linear 64→5)&lt;br&gt;• Registro 124 solo tiene 88 latidos (marcapaso) — no usar para demo&lt;br&gt;• Mejores registros para demo: 100, 200, 208 (&gt;2,000 latidos, variedad de clases)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;align=left;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="2200" y="1400" width="1000" height="140" as="geometry"/>
    </mxCell>


