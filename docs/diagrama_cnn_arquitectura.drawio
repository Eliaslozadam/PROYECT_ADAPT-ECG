    <!-- Flecha Flatten → Classifier -->
    <mxCell id="96" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="95" target="100" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ─── CLASSIFIER ────────────────────────────────────────────────── -->
    <mxCell id="100" value="&lt;b&gt;CLASIFICADOR (self.classifier)&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1740" y="520" width="260" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="101" value="&lt;b&gt;Linear(128 → 64)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;8,192 pesos + 64 bias = 8,256&lt;br&gt;Comprime la representación&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="100">
      <mxGeometry x="15" y="38" width="230" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="102" value="&lt;b&gt;ReLU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;f(x) = max(0, x)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="100">
      <mxGeometry x="15" y="103" width="230" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="103" value="&lt;b&gt;Dropout(p=0.5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Desactiva 50% de neuronas al azar&lt;br&gt;Solo activo en entrenamiento&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="100">
      <mxGeometry x="15" y="153" width="230" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="104" value="&lt;b&gt;Linear(64 → 5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;320 pesos + 5 bias = 325&lt;br&gt;5 logits (uno por clase AAMI)&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="100">
      <mxGeometry x="15" y="213" width="230" height="55" as="geometry"/>
    </mxCell>

    <!-- Flecha Classifier → Softmax -->
