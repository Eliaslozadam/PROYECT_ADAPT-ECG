    <!-- TÍTULO PRINCIPAL -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <mxCell id="2" value="&lt;font style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;ADAPT-ECG — Arquitectura CNN para Detección Adaptativa de Arritmias Cardiacas&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;Modelo Base: ecg_cnn_base.pth &amp;nbsp;|&amp;nbsp; Modelo Adaptativo: ADAPT-ECG-RETRAINED.pth &amp;nbsp;|&amp;nbsp; 44,229 parámetros entrenables&lt;br&gt;Elias Bejarano Lozada #20213057 — Residencia Profesional — Ingeniería Biomédica — ITT&lt;/font&gt;"
          style="text;html=1;align=center;verticalAlign=middle;strokeColor=#666666;fillColor=#f5f5f5;fontColor=#333333;rounded=1;fontSize=14;"
          vertex="1" parent="1">
      <mxGeometry x="150" y="20" width="3100" height="75" as="geometry"/>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECCIÓN A: OPERACIÓN DE CONVOLUCIÓN 1D (MATEMÁTICAS) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Fondo sección A -->
    <mxCell id="10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;opacity=60;" vertex="1" parent="1">
      <mxGeometry x="150" y="120" width="3100" height="340" as="geometry"/>
    </mxCell>

    <!-- Título sección A -->
    <mxCell id="11" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;A. ¿Cómo Funciona la Convolución 1D? — Operación Matemática&lt;/font&gt;&lt;/b&gt;"
          style="text;html=1;align=left;strokeColor=none;fillColor=none;fontColor=#e65100;fontSize=13;"
          vertex="1" parent="1">
      <mxGeometry x="170" y="130" width="900" height="30" as="geometry"/>
    </mxCell>

    <!-- Caja de fórmula matemática -->
    <mxCell id="12" value="&lt;b&gt;Fórmula de Convolución 1D:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;y[n] = &amp;Sigma; w[k] &amp;middot; x[n + k - pad]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;k=0 a K-1&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Donde:&lt;/b&gt;&lt;br&gt;y[n] = activación de salida en posición n&lt;br&gt;x[ ] = señal ECG de entrada (71 muestras)&lt;br&gt;w[k] = pesos del filtro (APRENDIDOS con backprop)&lt;br&gt;K = tamaño del kernel (5 o 3 según el bloque)&lt;br&gt;pad = ceros agregados en los bordes (2 o 1)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;align=left;verticalAlign=top;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="170" y="175" width="360" height="250" as="geometry"/>
    </mxCell>

    <!-- Título visual señal -->
    <mxCell id="13" value="&lt;b&gt;Señal ECG de entrada x[n] — latido segmentado (71 muestras)&lt;/b&gt;"
          style="text;html=1;align=center;strokeColor=none;fillColor=none;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="550" y="178" width="520" height="25" as="geometry"/>
    </mxCell>

    <!-- Celdas de la señal x[n] — 10 visibles -->
    <mxCell id="14" value="x[0]&lt;br&gt;0.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="550" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="15" value="x[1]&lt;br&gt;-0.34" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="605" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <!-- Posiciones activas donde se aplica el kernel (naranja) -->
    <mxCell id="16" value="x[2]&lt;br&gt;0.87" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="660" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="17" value="x[3]&lt;br&gt;1.25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="715" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="18" value="x[4]&lt;br&gt;0.95" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="770" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="19" value="x[5]&lt;br&gt;0.43" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="825" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="20" value="x[6]&lt;br&gt;-0.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="21" value="x[7]&lt;br&gt;-0.55" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="935" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="22" value="x[8]&lt;br&gt;0.22" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="990" y="210" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="23" value="..." style="text;html=1;align=center;strokeColor=none;fillColor=none;fontSize=18;" vertex="1" parent="1">
      <mxGeometry x="1048" y="212" width="40" height="46" as="geometry"/>
    </mxCell>

    <!-- Label kernel -->
    <mxCell id="24" value="&lt;b&gt;Kernel w[k] — 5 pesos entrenables (K=5, Block 1 y 2)&lt;br&gt;Se desliza sobre la señal calculando productos punto&lt;/b&gt;"
          style="text;html=1;align=center;strokeColor=none;fillColor=none;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="600" y="273" width="430" height="35" as="geometry"/>
    </mxCell>

    <!-- Celdas del kernel -->
    <mxCell id="25" value="w[0]&lt;br&gt;0.21" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="660" y="310" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="26" value="w[1]&lt;br&gt;-0.45" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="715" y="310" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="27" value="w[2]&lt;br&gt;0.78" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="770" y="310" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="28" value="w[3]&lt;br&gt;0.33" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="825" y="310" width="55" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="29" value="w[4]&lt;br&gt;-0.67" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="310" width="55" height="50" as="geometry"/>
    </mxCell>

    <!-- Cálculo ejemplo -->
    <mxCell id="30" value="&lt;b&gt;Cálculo del valor de salida y[2]:&lt;/b&gt;&lt;br&gt;y[2] = x[2]·w[0] + x[3]·w[1] + x[4]·w[2] + x[5]·w[3] + x[6]·w[4]&lt;br&gt;y[2] = 0.87·(0.21) + 1.25·(-0.45) + 0.95·(0.78) + 0.43·(0.33) + (-0.12)·(-0.67)&lt;br&gt;y[2] = 0.183 &amp;nbsp;—&amp;nbsp; 0.563 &amp;nbsp;+&amp;nbsp; 0.741 &amp;nbsp;+&amp;nbsp; 0.142 &amp;nbsp;+&amp;nbsp; 0.080 = &lt;b&gt;0.583&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="550" y="380" width="680" height="70" as="geometry"/>
    </mxCell>

    <!-- Nota sobre los 32 filtros -->
    <mxCell id="31" value="&lt;b&gt;¿Qué detecta la CNN?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Block 1 tiene &lt;b&gt;32 filtros (kernels)&lt;/b&gt; distintos. Cada uno aprende a detectar un patrón diferente:&lt;br&gt;• Pico R (contracción ventricular)&lt;br&gt;• Onda P (despolarización auricular)&lt;br&gt;• Onda T (repolarización ventricular)&lt;br&gt;• Segmento QRS y sus variaciones&lt;br&gt;&lt;br&gt;Block 2 tiene 64 filtros → combina patrones de Block 1&lt;br&gt;Block 3 tiene 128 filtros → representaciones de alto nivel&lt;br&gt;&lt;br&gt;Los pesos w[k] se aprenden automáticamente con &lt;b&gt;backpropagation&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;align=left;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="1260" y="175" width="430" height="250" as="geometry"/>
    </mxCell>

    <!-- BatchNorm y ReLU explicación -->
    <mxCell id="32" value="&lt;b&gt;BatchNorm1d — ¿Para qué sirve?&lt;/b&gt;&lt;br&gt;Normaliza las activaciones de cada capa.&lt;br&gt;Estabiliza el entrenamiento y permite&lt;br&gt;usar learning rates más altos.&lt;br&gt;&lt;br&gt;&lt;b&gt;ReLU — ¿Qué hace?&lt;/b&gt;&lt;br&gt;f(x) = max(0, x)&lt;br&gt;Activa solo valores positivos.&lt;br&gt;Introduce no-linealidad → permite&lt;br&gt;aprender patrones complejos.&lt;br&gt;&lt;br&gt;&lt;b&gt;MaxPool1d(2) — ¿Qué hace?&lt;/b&gt;&lt;br&gt;Reduce la longitud a la mitad.&lt;br&gt;Se queda con el valor máximo&lt;br&gt;de cada ventana de 2 muestras.&lt;br&gt;Reduce parámetros y hace el modelo&lt;br&gt;más robusto a desplazamientos."
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;align=left;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="1720" y="175" width="310" height="270" as="geometry"/>
    </mxCell>

    <!-- Dropout explicación -->
    <mxCell id="33" value="&lt;b&gt;Dropout(p=0.5)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Durante entrenamiento:&lt;br&gt;desactiva aleatoriamente&lt;br&gt;el 50% de neuronas.&lt;br&gt;&lt;br&gt;Durante inferencia:&lt;br&gt;usa todas las neuronas.&lt;br&gt;&lt;br&gt;Previene sobreajuste&lt;br&gt;(memorizar en lugar&lt;br&gt;de generalizar)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;align=left;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="2060" y="175" width="220" height="250" as="geometry"/>
    </mxCell>

    <!-- Parámetros totales quick ref -->
    <mxCell id="34" value="&lt;b&gt;Conteo de parámetros:&lt;/b&gt;&lt;br&gt;Block 1 Conv: 1×32×5 + 32 = &lt;b&gt;192&lt;/b&gt;&lt;br&gt;Block 2 Conv: 32×64×5 + 64 = &lt;b&gt;10,304&lt;/b&gt;&lt;br&gt;Block 3 Conv: 64×128×3 + 128 = &lt;b&gt;24,704&lt;/b&gt;&lt;br&gt;BatchNorm ×3: 2×(32+64+128) = &lt;b&gt;448&lt;/b&gt;&lt;br&gt;Linear(128→64): 128×64+64 = &lt;b&gt;8,256&lt;/b&gt;&lt;br&gt;Linear(64→5): 64×5+5 = &lt;b&gt;325&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;TOTAL: 44,229 parámetros&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;align=left;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="2310" y="175" width="300" height="250" as="geometry"/>
    </mxCell>


    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECCIÓN B: PIPELINE CNN COMPLETO (FORWARD PASS) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Fondo sección B -->
    <mxCell id="50" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;opacity=30;" vertex="1" parent="1">
      <mxGeometry x="150" y="490" width="3100" height="450" as="geometry"/>
    </mxCell>

    <!-- Título sección B -->
    <mxCell id="51" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;B. Pipeline Completo de la CNN — Forward Pass (Inferencia en tiempo real)&lt;/font&gt;&lt;/b&gt;"
          style="text;html=1;align=left;strokeColor=none;fillColor=none;fontColor=#6a1b9a;fontSize=13;"
          vertex="1" parent="1">
      <mxGeometry x="170" y="500" width="1200" height="30" as="geometry"/>
    </mxCell>

    <!-- ─── INPUT ────────────────────────────────────────────────────── -->
    <mxCell id="52" value="&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Latido ECG&lt;br&gt;segmentado y&lt;br&gt;normalizado&lt;br&gt;&lt;br&gt;Tensor:&lt;br&gt;&lt;b&gt;(batch, 1, 71)&lt;/b&gt;&lt;br&gt;&lt;br&gt;71 muestras:&lt;br&gt;35 antes del&lt;br&gt;pico R + pico R&lt;br&gt;+ 36 después"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#23445d;fontStyle=1;fontSize=10;"
          vertex="1" parent="1">
      <mxGeometry x="170" y="550" width="130" height="210" as="geometry"/>
    </mxCell>

    <!-- Flecha Input → Block1 -->
    <mxCell id="53" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="52" target="60" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ─── BLOCK 1 ────────────────────────────────────────────────────── -->
    <mxCell id="60" value="&lt;b&gt;BLOQUE 1&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="330" y="520" width="240" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="61" value="&lt;b&gt;Conv1d&lt;/b&gt;&lt;br&gt;in_ch=1 → out_ch=32&lt;br&gt;kernel_size=5, pad=2&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(batch, 32, 71)&lt;br&gt;32 filtros distintos&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;" vertex="1" parent="60">
      <mxGeometry x="15" y="38" width="210" height="75" as="geometry"/>
    </mxCell>

    <mxCell id="62" value="&lt;b&gt;BatchNorm1d(32) + ReLU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Normaliza y activa&lt;br&gt;solo valores positivos&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="60">
      <mxGeometry x="15" y="123" width="210" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="63" value="&lt;b&gt;MaxPool1d(2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;71 → 35 muestras&lt;br&gt;Toma el máximo de cada par&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="60">
      <mxGeometry x="15" y="188" width="210" height="55" as="geometry"/>
    </mxCell>

    <!-- Label dimensión salida Block 1 -->
    <mxCell id="64" value="(batch, 32, 35)" style="text;html=1;align=center;strokeColor=#d79b00;fillColor=#fff2cc;rounded=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="578" y="640" width="115" height="28" as="geometry"/>
    </mxCell>

    <!-- Flecha Block1 → Block2 -->
    <mxCell id="65" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="60" target="70" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ─── BLOCK 2 ────────────────────────────────────────────────────── -->
    <mxCell id="70" value="&lt;b&gt;BLOQUE 2&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="710" y="520" width="240" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="71" value="&lt;b&gt;Conv1d&lt;/b&gt;&lt;br&gt;in_ch=32 → out_ch=64&lt;br&gt;kernel_size=5, pad=2&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(batch, 64, 35)&lt;br&gt;Combina patrones del Block 1&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;" vertex="1" parent="70">
      <mxGeometry x="15" y="38" width="210" height="75" as="geometry"/>
    </mxCell>

    <mxCell id="72" value="&lt;b&gt;BatchNorm1d(64) + ReLU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Detecta patrones más complejos&lt;br&gt;combinando los 32 anteriores&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="70">
      <mxGeometry x="15" y="123" width="210" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="73" value="&lt;b&gt;MaxPool1d(2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;35 → 17 muestras&lt;br&gt;Toma el máximo de cada par&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="70">
      <mxGeometry x="15" y="188" width="210" height="55" as="geometry"/>
    </mxCell>

    <!-- Label dimensión salida Block 2 -->
    <mxCell id="74" value="(batch, 64, 17)" style="text;html=1;align=center;strokeColor=#d79b00;fillColor=#fff2cc;rounded=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="958" y="640" width="115" height="28" as="geometry"/>
    </mxCell>

    <!-- Flecha Block2 → Block3 -->
    <mxCell id="75" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="70" target="80" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ─── BLOCK 3 ────────────────────────────────────────────────────── -->
    <mxCell id="80" value="&lt;b&gt;BLOQUE 3&lt;/b&gt;" style="swimlane;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1090" y="520" width="240" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="81" value="&lt;b&gt;Conv1d&lt;/b&gt;&lt;br&gt;in_ch=64 → out_ch=128&lt;br&gt;kernel_size=3, pad=1&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(batch, 128, 17)&lt;br&gt;Representaciones de alto nivel&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontSize=10;" vertex="1" parent="80">
      <mxGeometry x="15" y="38" width="210" height="75" as="geometry"/>
    </mxCell>

    <mxCell id="82" value="&lt;b&gt;BatchNorm1d(128) + ReLU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Morfología completa del latido:&lt;br&gt;forma QRS, segmento ST, onda T&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="80">
      <mxGeometry x="15" y="123" width="210" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="83" value="&lt;b&gt;MaxPool1d(2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;17 → 8 muestras&lt;br&gt;Toma el máximo de cada par&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="80">
      <mxGeometry x="15" y="188" width="210" height="55" as="geometry"/>
    </mxCell>

    <!-- Label dimensión salida Block 3 -->
    <mxCell id="84" value="(batch, 128, 8)" style="text;html=1;align=center;strokeColor=#d79b00;fillColor=#fff2cc;rounded=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1338" y="640" width="115" height="28" as="geometry"/>
    </mxCell>

    <!-- Flecha Block3 → AvgPool -->
    <mxCell id="85" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="80" target="90" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ─── ADAPTIVE AVG POOL ─────────────────────────────────────────── -->
    <mxCell id="90" value="&lt;b&gt;AdaptiveAvgPool1d(1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 muestras → 1&lt;br&gt;Promedia todo el canal&lt;br&gt;&lt;br&gt;&lt;b&gt;(batch, 128, 1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Un valor por canal&lt;br&gt;independiente del tamaño&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          vertex="1" parent="1">
      <mxGeometry x="1360" y="575" width="175" height="150" as="geometry"/>
    </mxCell>

    <!-- Flecha AvgPool → Flatten -->
    <mxCell id="91" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=2;" edge="1" source="90" target="95" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ─── FLATTEN ─────────────────────────────────────────────────── -->
    <mxCell id="95" value="&lt;b&gt;Flatten&lt;/b&gt;&lt;br&gt;&lt;br&gt;(batch,128,1)&lt;br&gt;→&lt;br&gt;&lt;b&gt;(batch, 128)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Vector 1D listo&lt;br&gt;para capas densas&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
          vertex="1" parent="1">
